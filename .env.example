# Copier ce fichier en .env puis remplir les valeurs. Le .env n'est JAMAIS versionné.
# Générer une clé :  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire

# PostgreSQL local (en développement)
DB_NAME=quranova
DB_USER=quranova
DB_PASSWORD=remplacer-par-le-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# --- Production (serveur de salle, config.settings.prod) -------------------------------------------------------
# Adresses par lesquelles les tablettes joignent le serveur, séparées par des virgules (pas de « * »).
# DJANGO_ALLOWED_HOSTS=192.168.50.10,quranova.local
# Redis (couche de canaux WebSocket) ; la valeur ci-dessous est celle du Docker Compose.
# REDIS_URL=redis://redis:6379/0
# Origines autorisées pour les formulaires ; à défaut : http://<chaque hôte autorisé>.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.50.10
# 1 seulement si le serveur est en HTTPS (cookies « secure »).
# DJANGO_HTTPS=0
# Docker Compose : port d'écoute (80 par défaut) et dossier des sauvegardes (idéalement un disque externe).
# PORT_HTTP=80
# DOSSIER_SAUVEGARDES=E:\sauvegardes
# DJANGO_LOG_LEVEL=INFO
# Pool de connexions PostgreSQL : actif par défaut ; 0 pour le désactiver. Taille maximale : DB_POOL_MAX (20).
# DB_POOL=1
